# 메디가이드 환경설정 — EC2에서는 deploy/setup_ec2.sh 가 .env 로 복사합니다
MG_LLM=bedrock
MG_BEDROCK_MODEL=            # 운영진이 안내한 Bedrock 모델 ID (예: 추론 프로필 ID)
AWS_REGION=ap-northeast-2
# AWS 자격증명은 EC2 인스턴스 역할(IAM Role)로 주는 것을 권장 (키를 파일에 쓰지 않음)
MG_SECRET=change-me
MG_ADMIN_PASSWORD=           # 처음 실행 때 만들어지는 admin 계정 비밀번호
MG_VERIFIER_PASSWORD=        # verifier 계정 비밀번호
