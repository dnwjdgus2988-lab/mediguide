# 메디가이드 환경설정 — deploy/setup_ec2.sh 가 .env 로 복사합니다 (값 뒤에 주석을 붙이지 마세요)
MG_LLM=bedrock
# 운영진이 안내한 Bedrock 모델 ID
MG_BEDROCK_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
# 대회 서버 리전 (오리건)
AWS_REGION=us-west-2
MG_SECRET=change-me
# 비워 두면 scripts/seed_demo.py 상단 주석의 기본값을 씁니다
MG_ADMIN_PASSWORD=
MG_VERIFIER_PASSWORD=
