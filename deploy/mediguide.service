[Unit]
Description=MediGuide web service
After=network.target

[Service]
User=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
Environment=PYTHONUTF8=1
ExecStart=__APP_DIR__/.venv/bin/uvicorn web.main:app --host 127.0.0.1 --port 8501 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
